{
  "name": "void-xyp3rn-mastering",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "worklet": "node scripts/build-worklet.mjs",
    "dev": "npm run worklet && next dev",
    "build": "npm run worklet && next build",
    "serve": "node scripts/serve-static.mjs out",
    "oracle:fetch": "node scripts/fetch-oracle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.6.1",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "postcss": "8.5.30",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
